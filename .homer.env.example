# Recovery defaults: remain paused, do not upload or alter the existing queue.
HOMER_PAUSE=1
HOMER_AUTO_UPLOAD=0
HOMER_NONINTERACTIVE=1
HOMER_REQUIRE_BOTH=1
HOMER_BROADCAST_MAX_SECS=15
HOMER_TOTAL_MAX_SECS=30
HOMER_DISABLE_CLEANUP=1
HOMER_NOTIFY_IMESSAGE=0
HOMER_NOTIFY_PHONE=
HOMER_WEBHOOK_URL=
# Observed nonsecret numeric/boolean settings are in recovery/evidence/.
# Restore actual private configuration from your secure backup while still paused.
